# Caro XP reads this file from the project root when it starts.
# Copy to .env and enter your own Anthropic key. Leave empty for offline Minimax.
ANTHROPIC_API_KEY=
CARO_LLM_PROVIDER=anthropic
# Optional: leave blank to use the built-in Claude model default.
CARO_LLM_MODEL=
# Optional settings for an OpenAI-compatible provider only.
CARO_LLM_BASE_URL=
CARO_LLM_API_KEY=
